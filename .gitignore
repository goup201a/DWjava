
# ==========================================
# Eclipse + Java Team Project
# ==========================================

# 1. Java 컴파일 결과물
*.class
*.jar
*.war
*.ear

# 2. 빌드 결과물
bin/
target/
build/
out/

# 3. Eclipse 개인 작업 환경
.metadata/
.recommenders/
*.launch

# 4. Eclipse 임시 파일
*.tmp
*.bak
*.swp
*~

# 5. 로그 파일
*.log
logs/

# 6. 운영체제 자동 생성 파일
.DS_Store
Thumbs.db
desktop.ini

# 7. IDE 기타 설정
.idea/
*.iml
.vscode/

# ==========================================
# Eclipse 프로젝트 공유 필수 파일
# ==========================================

# 아래 파일은 GitHub에 업로드해야 하므로
# .gitignore에서 제외하지 않습니다.

# .project
# .classpath
# .settings/

# ==========================================
# 소스코드 및 라이브러리
# ==========================================

# src/ : Java 소스코드 공유
# lib/ : 외부 라이브러리 공유
# pom.xml : Maven 프로젝트 설정
# build.gradle : Gradle 프로젝트 설정

# ==========================================
# End
